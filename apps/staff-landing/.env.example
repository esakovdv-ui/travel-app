# Секрет для подписи httpOnly-сессии (минимум 16 символов)
STAFF_SESSION_SECRET=

# Базовый домен рабочей почты (по умолчанию mos.ru).
# Пускаем сам домен и любые его поддомены: mos.ru, culture.mos.ru, dept.mos.ru.
# STAFF_EMAIL_DOMAIN=mos.ru

# true на проде (HTTPS)
# COOKIE_SECURE=true

# Tourvisor API
# TOURVISOR_TOKEN=
#
# Догрузка выдачи: Tourvisor отдаёт отели порциями, каждый continue добавляет
# следующую. Крутим цикл, пока список растёт — на типовом запросе это 450
# отелей против 150 на старте, около 3.5 минут. Потолки страхуют от зависания,
# а не экономят квоту: continue в суточный лимит тарифа не входит.
# NEXT_PUBLIC_TV_MAX_EXPAND_ROUNDS=40
# NEXT_PUBLIC_TV_EXPAND_BUDGET_MS=240000

# ─── Bitrix24 ───────────────────────────────────
# BITRIX_DOMAIN=crm.mosgortur.ru
# WEBHOOK_TOKEN=<user_id>/<token>  — берём вебхук админского пользователя 1,
#   чтобы владелец вебхука совпадал с ответственным за сделки
# STAFF_DEAL_CATEGORY_ID=22
# STAFF_DEAL_STAGE_ID=C22:NEW
#
# Очередь ответственных: заявки раздаются по кругу между этими менеджерами.
# Позиция круга лежит в data/lead-queue.json и переживает выкат.
# 10 — Юлия Веркеенко, 8 — Анастасия Зыкова, 51 — Алевтина Иванова
# STAFF_DEAL_QUEUE_IDS=10,8,51
#
# Наблюдатели сделки. Ответственный из списка отбрасывается автоматически.
# 1981 — Артур Плешаков, дальше те же старшие менеджеры
# STAFF_DEAL_OBSERVER_IDS=1981,10,8,51
#
# Чат, куда падает уведомление о новой заявке. Вебхук видит только чаты, где
# состоит его владелец: chat1130 — «МП общая».
# STAFF_LEAD_CHAT_ID=chat1130

# ─── Яндекс Карты JS API ────────────────────────
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# ─── Админка /admin ─────────────────────────────
# Пароль к журналу входов сотрудников
# STAFF_ADMIN_PASSWORD=

# ─── Яндекс.Метрика ─────────────────────────────
# По умолчанию 109401746 (общий счётчик motrip)
# NEXT_PUBLIC_YM_COUNTER_ID=

# Каталог журнала входов (по умолчанию ./data)
# STAFF_ACCESS_LOG_DIR=
