# ─────────────────────────────────────────────
# Переменные окружения — заполнить перед деплоем
# Этот файл — шаблон. Реальные значения хранить в .env.local (не коммитить)
# ─────────────────────────────────────────────

# ── База данных ───────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mytrip

# ── Level Travel API ──────────────────────────
LEVEL_TRAVEL_API_KEY=your_api_key_here
NEXT_PUBLIC_WL_BASE_URL=https://russia.mosgortur.ru

# ── Сессии ───────────────────────────────────
JWT_SECRET=replace_with_long_random_secret_min_32_chars
COOKIE_SECURE=true

# ── Email-уведомления (истории путешествий) ───
# Используется для отправки письма Анне Бочковой при новой истории
# Настроить SMTP или сервис (Nodemailer / Resend / SendGrid)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@mosgortur.ru
SMTP_PASS=your_smtp_password

# Email модератора историй (Анна Бочкова)
STORIES_NOTIFY_EMAIL=a.bochkova@mosgortur.ru

# Тема письма будет: "Новая история путешествия — [Объект] — [Дата]"

# ── Битрикс24 — лендинг перебронирования (/rebooking) ───
REBOOKING_BITRIX_DOMAIN=crm.mosgortur.ru
REBOOKING_WEBHOOK_TOKEN=1981/j9pvdbhovvem7j6c
# Смарт-процесс «Перебронирование Крым» → стадия «Перебронь» (defaults ниже)
# REBOOKING_BITRIX_ENTITY_TYPE_ID=1302
# REBOOKING_BITRIX_CATEGORY_ID=61
# REBOOKING_BITRIX_STAGE_ID=DT1302_61:NEW
# REBOOKING_BITRIX_ANNUL_STAGE_ID=DT1302_61:UC_QEP35A

# Tourvisor export API (webhook заявок → /api/tourvisor-order-webhook)
TOURVISOR_AUTHKEY=
# Tourvisor Search API (operatorLink для операторов без operatorlink в export, напр. Алеан)
TOURVISOR_TOKEN=

# ── Podbor funnel → Google Sheets ─────────────────
# OAuth Яндекс.Метрики (счётчики 90662828, 109401746, 97107007)
# YANDEX_METRIKA_TOKEN=
# ID таблицы (default уже задан в скрипте)
# PODBOR_SHEET_ID=1hgznwftwCCB9RRsLzVfm8jSKjAk8irZNruiIYBWgLMQ
# Дата начала учёта воронки (МСK). До неё — нули. Default: 2026-08-13
# PODBOR_FUNNEL_START=2026-08-13
# JSON ключ сервис-аккаунта Google (path или inline JSON). Таблицу расшарить на client_email SA.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Шаблон ссылки на заявку в Tourvisor PRO для операторов без operatorlink (плейсхолдер {orderId})
REBOOKING_TOURVISOR_PRO_ORDER_URL=https://pro.tourvisor.ru/orders/{orderId}

# Админка визитов /rebooking-admin (по умолчанию: rebooking2026)
REBOOKING_ADMIN_PASSWORD=rebooking2026
# REBOOKING_VISITS_PATH=storage/rebooking-visits.json
# REBOOKING_ANNULS_PATH=storage/rebooking-annuls.json
